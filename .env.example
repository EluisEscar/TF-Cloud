# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el .env real al repo (está en .gitignore).

# ─── Supabase ──────────────────────────────────────────────────────────────
# Connection string Postgres directo (Settings → Database → Connection string → URI).
# Recomendado: usa el "Transaction pooler" (puerto 6543) para batch inserts.
# Reemplaza [YOUR-PASSWORD] por la contraseña de la DB.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# URL y anon key para el cliente JS-like (lo usa el frontend Streamlit).
# Settings → API → Project URL / anon public key.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── API ───────────────────────────────────────────────────────────────────
# URL de la API FastAPI (en desarrollo apunta a localhost; en Streamlit Cloud
# usa la URL pública de Render). Lo usa el frontend.
API_URL=http://localhost:8000

# ─── AWS S3 (modelo entrenado) ─────────────────────────────────────────────
# Si defines S3_BUCKET, la API descarga rf_aqi.pkl y features.json del bucket
# al arrancar (en lugar de usar el .pkl bundleado). En la EC2 las credenciales
# las da el IAM role automáticamente, así que solo S3_BUCKET y AWS_REGION son
# necesarias allí. En local debes pasar también las dos access keys.
S3_BUCKET=aqi-almaty-models-ee
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ─── SageMaker training ────────────────────────────────────────────────────
# ARN del IAM role aqi-sagemaker-role. Lo usa sagemaker/launch_training.py.
SAGEMAKER_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/aqi-sagemaker-role
# Buckets que usa el pipeline (datos crudos y modelos entrenados).
DATA_BUCKET=aqi-almaty-data-ee
MODEL_BUCKET=aqi-almaty-models-ee
# Tipo de instancia para entrenar. ml.m5.large ≈ $0.10/h (training tarda ~3-5 min).
SM_INSTANCE_TYPE=ml.m5.large

# ─── AWS Athena + Glue (data lake) ─────────────────────────────────────────
# Usados por ml_pipeline/athena_setup.py y prepare_data_athena.py para
# consultar el S3 público de OpenAQ con SQL en lugar de descargar miles
# de CSVs en paralelo.
ATHENA_RESULTS_BUCKET=aqi-athena-results-ee
GLUE_DATABASE=openaq_aqi

# ─── OpenAQ ────────────────────────────────────────────────────────────────
# API key (obligatoria desde 2024). Gratis en:
#   https://explore.openaq.org/register
# Necesaria para sagemaker/explore_openaq.py y el job de entrenamiento que
# lista estaciones por país.
OPENAQ_API_KEY=

# ─── Hugging Face (alternativa a S3, opcional) ─────────────────────────────
# Si NO defines S3_BUCKET pero sí HF_MODEL_REPO, la API descarga el modelo
# desde Hugging Face Hub (útil si reentrenas con Databricks).
# HF_MODEL_REPO=usuario/aqi-rf
# HF_TOKEN=hf_...  # solo si el repo es privado
