# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el .env real al repo (está en .gitignore).

# ─── Supabase ──────────────────────────────────────────────────────────────
# Connection string Postgres directo (Settings → Database → Connection string → URI).
# Recomendado: usa el "Transaction pooler" (puerto 6543) para batch inserts.
# Reemplaza [YOUR-PASSWORD] por la contraseña de la DB.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# URL y anon key para el cliente JS-like (lo usa el frontend Streamlit).
# Settings → API → Project URL / anon public key.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── API ───────────────────────────────────────────────────────────────────
# URL de la API FastAPI (en desarrollo apunta a localhost; en Streamlit Cloud
# usa la URL pública de Render). Lo usa el frontend.
API_URL=http://localhost:8000
