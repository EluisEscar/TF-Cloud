# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el .env real al repo (está en .gitignore).

# ─── Supabase ──────────────────────────────────────────────────────────────
# Connection string Postgres. Para batch uploads (scripts) usa Session
# pooler en puerto 5432; para apps con muchas conexiones cortas, el
# Transaction pooler en 6543 está bien.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-1-<REGION>.pooler.supabase.com:5432/postgres

# URL y anon key para el cliente del frontend Streamlit.
# Settings → API → Project URL / anon public key.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── API ───────────────────────────────────────────────────────────────────
# URL de la API FastAPI (en desarrollo apunta a localhost; en Streamlit
# Cloud usa la URL pública de la EC2). Lo usa el frontend.
API_URL=http://localhost:8000

# ─── AWS ───────────────────────────────────────────────────────────────────
# Si defines S3_BUCKET, la API descarga rf_aqi.pkl y features.json del
# bucket al arrancar. En la EC2 las credenciales las da el IAM role
# automáticamente. En local debes pasar también las dos access keys.
S3_BUCKET=aqi-almaty-models-ee
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Buckets del pipeline ML.
DATA_BUCKET=aqi-almaty-data-ee
MODEL_BUCKET=aqi-almaty-models-ee

# ─── AWS Athena + Glue (data lake) ─────────────────────────────────────────
# Usados por ml_pipeline/athena_setup.py y prepare_data_athena.py para
# consultar el S3 público de OpenAQ con SQL.
ATHENA_RESULTS_BUCKET=aqi-athena-results-ee
GLUE_DATABASE=openaq_aqi

# ─── OpenAQ ────────────────────────────────────────────────────────────────
# API key (obligatoria desde 2024). Gratis en:
#   https://explore.openaq.org/register
OPENAQ_API_KEY=

# ─── Hugging Face (alternativa a S3, opcional) ─────────────────────────────
# Si NO defines S3_BUCKET pero sí HF_MODEL_REPO, la API descarga el modelo
# desde Hugging Face Hub.
# HF_MODEL_REPO=usuario/aqi-rf
# HF_TOKEN=hf_...  # solo si el repo es privado
